{
  "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
  "name": "ForgePilot Autopilot — Pending genehmigen v2",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "schedule-trigger",
      "name": "Alle 5 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://forgepilot:3000/api/delegations",
        "options": {}
      },
      "id": "get-delegations",
      "name": "Pending Delegationen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const all = $input.first().json;\nconst pending = (Array.isArray(all) ? all : all.delegations || [])\n  .filter(d =>\n    d.status === 'pending' &&\n    (d.contract?.riskClass === 'A' || d.contract?.riskClass === 'B')\n  )\n  // Älteste zuerst genehmigen (FIFO)\n  .sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime())\n  // Max. 10 pro Lauf — Schutz vor Burst\n  .slice(0, 10);\n\nif (pending.length === 0) {\n  return [];\n}\n\nconsole.log(`[Autopilot] ${pending.length} Delegation(en) werden genehmigt`);\nreturn pending.map(d => ({ json: d }));"
      },
      "id": "filter-pending",
      "name": "Class A/B filtern (max 10)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://forgepilot:3000/api/delegations/{{ $json.id }}/approve",
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "approve",
      "name": "Genehmigen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "check-approved",
              "leftValue": "={{ $json.status }}",
              "rightValue": "approved",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-approved",
      "name": "Genehmigt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://forgepilot:3000/api/delegations/{{ $json.id }}/start",
        "options": {
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "start-execution",
      "name": "Ausführung starten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 180]
    }
  ],
