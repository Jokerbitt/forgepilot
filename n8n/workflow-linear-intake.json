      "parameters": {
        "jsCode": "const issue = $input.first().json.body.data || $input.first().json.body;\nconst title = issue.title || issue.data?.title || 'Neues Linear-Ticket';\nconst description = issue.description || issue.data?.description || '';\nconst priority = issue.priority || issue.data?.priority || 0;\n\n// Priorität → Scope mappen\nconst scope = priority <= 1 ? 'deep' : priority <= 2 ? 'standard' : 'quick';\n\nreturn [{\n  json: {\n    title,\n    rawIdea: description || title,\n    problemStatement: description,\n    targetAudience: 'ForgePilot-Nutzer',\n    desiredOutcome: `Issue '${title}' vollständig umsetzen`,\n    scope,\n    privacyMode: 'local',\n    source: 'linear-webhook',\n    linearIssueId: issue.id || issue.data?.id,\n    linearIdentifier: issue.identifier || issue.data?.identifier\n  }\n}];"
