{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/delegation-queue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/connector-sync",
      "schedule": "*/15 * * * *"
    }
  ]
}
