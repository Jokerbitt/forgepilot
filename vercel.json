{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/journey-maintenance",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/telegram-digest",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/ai/providers/health",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/delegation-queue",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/connector-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/pr-status-sync",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/knowledge-index",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/agent-heartbeat",
      "schedule": "*/5 * * * *"
    }
  ]
}
