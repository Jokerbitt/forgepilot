{
  "name": "forgepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "validate": "bash scripts/pre-commit-check.sh",
    "validate:quick": "bash scripts/pre-commit-check.sh --quick",
    "validate:agent": "bash scripts/validate-agent-work.sh",
    "agent": "node scripts/agent-coord.mjs",
    "agent:status": "node scripts/agent-coord.mjs status",
    "agent:preflight": "node scripts/agent-coord.mjs preflight",
    "seed": "tsx scripts/seed-demo.ts",
    "seed:clean": "rm -f config/local-items.json config/delegations.json config/orchestrated-runs.json && npm run seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/supabase-js": "^2.106.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.16.0",
    "next": "15.5.18",
    "openai": "^6.38.0",
    "pino": "^10.3.1",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/pino": "^7.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.0.4",
    "eslint": "^8",
    "eslint-config-next": "15.5.18",
    "pino-pretty": "^13.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^1"
  }
}
