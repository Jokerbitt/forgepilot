{
  "name": "forgepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "type-check": "tsc --noEmit",
    "validate": "bash scripts/pre-commit-check.sh",
    "validate:quick": "bash scripts/pre-commit-check.sh --quick",
    "validate:agent": "bash scripts/validate-agent-work.sh",
    "agent": "node scripts/agent-coord.mjs",
    "agent:status": "node scripts/agent-coord.mjs status",
    "agent:preflight": "node scripts/agent-coord.mjs preflight",
    "agent:check": "node scripts/agent-coord.mjs check-staged",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backfill": "tsx scripts/backfill-json-to-postgres.ts",
    "db:backfill-ledger": "tsx scripts/backfill-processing-ledger-to-postgres.ts",
    "db:backfill-supabase": "tsx scripts/backfill-json-to-pg.ts",
    "db:verify-cutover": "tsx scripts/verify-postgres-cutover.ts",
    "critic:backfill": "tsx scripts/backfill-critic-scores.ts",
    "knowledge:backfill": "tsx scripts/backfill-knowledge-writebacks.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "seed:clean": "rm -f config/local-items.json config/delegations.json config/orchestrated-runs.json && npm run seed",
    "test:flow": "tsx scripts/test-flow.ts",
    "test:flow:verbose": "tsx scripts/test-flow.ts --verbose",
    "test:flow:ollama": "tsx scripts/test-flow.ts --provider=ollama --verbose",
    "test:flow:dry": "tsx scripts/test-flow.ts --dry-run",
    "evidence:record": "tsx scripts/record-execute-loop-evidence.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.33.0",
    "next": "15.5.23",
    "next-auth": "^4.24.15",
    "openai": "^6.49.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/pino": "^7.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "15.5.23",
    "pino-pretty": "^13.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
