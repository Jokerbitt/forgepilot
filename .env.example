# ════════════════════════════════════════════════════════════════
# ForgePilot — Environment Variables
# Copy to .env.local and fill in your values.
# Most variables are optional. Auth is enabled by default; change the admin password.
# ════════════════════════════════════════════════════════════════

# ── System paths ────────────────────────────────────────────────
# Where config/state JSON files are stored (default: ./config)
# Can point to any drive: /mnt/data, D:\ForgePilot\config, etc.
# FORGEPILOT_DATA_DIR=/path/to/config

# Where your documentation/knowledge base lives (optional)
# Set this to enable the Knowledge Indexer
# FORGEPILOT_DOCS_DIR=/Volumes/MyDrive/docs

# ── AI Providers ─────────────────────────────────────────────────
# Add the key for whichever provider(s) you want to use.
# You only need ONE — ForgePilot works with any.

# AI Provider Fallback (optional)
# FORGEPILOT_FALLBACK_PROVIDER=

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI GPT (https://platform.openai.com)
# OPENAI_API_KEY=sk-proj-...

# Groq — ultra-fast, free tier (https://console.groq.com)
# GROQ_API_KEY=gsk_...

# ─── Sentry (optional) ──────────────────────────────────────────────────────
# Error monitoring + performance tracing (M97)
# Get DSN at https://sentry.io → Project → Settings → Client Keys
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=forgepilot

# ─── OpenTelemetry (optional) ────────────────────────────────────────────────
# Distributed tracing (M98) — export to Jaeger (local) or Honeycomb (prod)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY
# LOG_LEVEL=info                   # Pino log level: trace | debug | info | warn | error | fatal

# ─── Vercel Deployment (M99) ────────────────────────────────────────────────
# Required GitHub Actions secrets for .github/workflows/deploy.yml:
#   VERCEL_TOKEN      → vercel.com/account/tokens → Create Token
#   VERCEL_ORG_ID     → vercel.com/account → Settings → General → Team ID
#   VERCEL_PROJECT_ID → vercel.com/<project> → Settings → General → Project ID
#
# Set in local .env.local (set automatically by Vercel when deployed):
# VERCEL_URL=https://forgepilot-pr-123.vercel.app
#
# Cron auth secret — set the same value in Vercel Environment Variables:
# SECURITY: Generate with: openssl rand -base64 32
# CRON_SECRET=your-long-random-secret-here

# ─── API Key Authentication (optional — set to protect all /api/ routes) ────
# If set, all /api/ routes require: Authorization: Bearer <key>
# Excluded from check: /api/intake, /api/cron/*, /api/health, /api/ready, /api/webhooks/*
# Generate with: openssl rand -hex 32
# FORGEPILOT_API_KEY=

# ─── Webhook Security (optional — HMAC validation for /api/intake) ──────────
# Generate with: openssl rand -hex 32
# INTAKE_WEBHOOK_SECRET=

# Mistral AI — EU-based, DSGVO-friendly (https://console.mistral.ai)
# MISTRAL_API_KEY=...

# Google Gemini (https://aistudio.google.com)
# GOOGLE_API_KEY=AIza...

# Together AI — open models (https://api.together.xyz)
# TOGETHER_API_KEY=...

# Cohere — embeddings + Command R models (https://cohere.com — free trial key)
# COHERE_API_KEY=...

# Fireworks AI — fast open-source models (https://fireworks.ai — $1 free credits)
# FIREWORKS_API_KEY=...

# Ollama — local, no API key needed
# OLLAMA_BASE_URL=http://localhost:11434

# LM Studio — local OpenAI-compatible server
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ── Supabase (optional — enhances ForgePilot with realtime + vector search)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# ── Connectors ───────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_...
# GitHub Integration (optional — PR auto-creation)
# GITHUB_REPO=owner/repo
# LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM_ID=team-...

# ── Deployment ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Supabase (extended) ──────────────────────────────────────────
# SUPABASE_SERVICE_KEY=eyJ...

# ── Linear Integration (extended) ───────────────────────────────
# LINEAR_WEBHOOK_SECRET=...

# ── GitHub Webhook (M214 — bidirectional sync) ───────────────────
# Generate with: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# ── Telegram Bot (M151) ─────────────────────────────────────────
# Optional: configure in /settings → Telegram section instead of env vars
# TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFfGgHhIiJjKkLlMm...
# TELEGRAM_CHAT_ID=123456789          # numeric chat ID or @channelname
# TELEGRAM_WEBHOOK_SECRET=your-long-random-secret-for-webhook-verification

# ── Notifications (optional — M204) ─────────────────────────────
# Resend email: https://resend.com
# RESEND_API_KEY=re_...
# NOTIFICATION_EMAIL=you@example.com

# ── Next.js ──────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Auth (mandatory for all deployments) ──────────────────────────────────────
# Auth is ENABLED by default. ForgePilot must not run open on a local network,
# Docker host, or NAS without valid credentials.
#
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Admin credentials for the ForgePilot login page.
# SECURITY: Use a strong password (min. 12 chars). Change before any deployment.
FORGEPILOT_ADMIN_EMAIL=admin@example.com
FORGEPILOT_ADMIN_PASSWORD=change-me-before-deploy
# FORGEPILOT_ADMIN_NAME=Admin
# FORGEPILOT_TENANT_ID=default

# Dev bypass — ONLY for isolated local development with no network exposure.
# Setting this to "true" disables all session checks. NEVER use in production,
# Docker, or NAS deployments.
# FORGEPILOT_AUTH_DISABLED=true

# ─── Grok / xAI Critic (M165) ─────────────────────────────────────────────────
# Get $25 free credits at https://console.x.ai
# XAI_API_KEY=xai-...
#
# ─── Critic LLM Router ────────────────────────────────────────────────────────
# auto        = try explicitly configured critics, selected app models, strong cloud critics,
#               then local Ollama/LM Studio. Recommended.
# local-first = prefer Ollama/LM Studio before cloud critics.
# cloud-first = use only configured cloud critics.
# single      = use only FORGEPILOT_CRITIC_PROVIDER/FORGEPILOT_CRITIC_MODEL.
# FORGEPILOT_CRITIC_MODE=auto
#
# Optional ordered critic chain. Supports any configured provider id, including
# built-ins (xai, anthropic, openai, openrouter, groq, deepseek, gemini, ollama,
# lm-studio) and custom OpenAI-compatible providers from Settings.
# Format: provider=model,provider:model,provider
# FORGEPILOT_CRITIC_PROVIDERS=xai=grok-3-mini,anthropic=claude-sonnet-4-5,ollama=qwen2.5-coder:14b
#
# Backwards-compatible single critic override:
# FORGEPILOT_CRITIC_PROVIDER=ollama
# FORGEPILOT_CRITIC_MODEL=qwen2.5-coder:14b
#
# Optional local Hermes critic profile. Install/pull a Hermes-compatible Ollama
# model first, then set the exact model name here.
# FORGEPILOT_HERMES_MODEL=nous-hermes2:latest
#
# Optional OpenClaw coding agent. Keep unset until a local CLI or private endpoint
# is configured. Never put auth tokens in prompts, reports, or planning payloads.
# OPENCLAW_CLI=openclaw
# OPENCLAW_ENDPOINT=http://localhost:8787

# ─── Storage Mode (JOK-175) ─────────────────────────────────────────────────────
# Controls which persistence backend ForgePilot uses.
#
#   json     = File-based JSON under config/*.json   (Phase-0 / Dev / Bootstrap — Default)
#   dual     = JSON + PostgreSQL parallel writes     (Migration phase — requires DATABASE_URL)
#   postgres = PostgreSQL only                       (Production — requires DATABASE_URL)
#
# WARNING: JSON is NOT a production persistence path.
#   - No ACID guarantees — data loss possible on crash
#   - Race conditions with concurrent writes
#   - Not suitable for multi-user production deployments
#
# Migration: npx tsx scripts/backfill-json-to-postgres.ts --dry-run
#            npx tsx scripts/backfill-json-to-postgres.ts
#
# Local bootstrap can use json, but productive autonomous operation should use postgres.
# Keep json only for quick isolated development without concurrent agents.
# STORAGE_MODE=json
# STORAGE_MODE=dual
STORAGE_MODE=postgres

# ─── PostgreSQL (optional — app works without it using JSON files) ─────────────
DATABASE_URL=postgresql://forgepilot:forgepilot@localhost:5432/forgepilot
# Legacy per-repository storage mode override (overrides STORAGE_MODE for delegations only):
# FORGEPILOT_DELEGATION_STORAGE=postgres
# Setup: docker-compose up -d postgres && npm run db:push
# Backfill existing JSON data: npm run db:backfill
# POSTGRES_USER=forgepilot
# POSTGRES_PASSWORD=forgepilot
# POSTGRES_DB=forgepilot

# ─── Agent Runner Worktrees ─────────────────────────────────────────────────
# Each delegation runs in its own throwaway git worktree so the agent cannot
# disturb the user's working tree. These variables tune where worktrees live,
# which ref they branch from, and whether failed runs are kept for inspection.
#
# Directory that holds the per-delegation worktrees.
# Default: <os tmpdir>/forgepilot-runner-worktrees
# FORGEPILOT_RUNNER_ROOT=/var/forgepilot/runner-worktrees
#
# Git ref the worktree is created from. Use `origin/main` in production so
# runners always start from the latest pushed main; defaults to `HEAD` for
# local development so feature branches can be tested without pushing first.
# FORGEPILOT_RUNNER_BASE_REF=origin/main
#
# Keep every runner worktree on disk after the run (success or failure).
# Useful for debugging; set to `true` to disable cleanup entirely.
# FORGEPILOT_KEEP_RUNNER_WORKTREES=false
#
# Retain worktrees of FAILED runs only, so a human can inspect what happened.
# Defaults to keeping failed worktrees; set to `false` to clean them up too.
# FORGEPILOT_KEEP_FAILED_RUNNER_WORKTREES=true
#
# ADR-003 D1: pre-spawn policy gate enforcement. When armed, a delegation whose
# contract the Deny-first policy engine denies (Risk-C, secret/destructive tools,
# public privacy) is hard-blocked (HTTP 403, status failed) BEFORE the agent
# spawns. Truthy = 1/true/on/yes. Unset / 0 = report-only (the violation is logged
# but the run proceeds). Prod (docker-compose) defaults this to 1.
# FORGEPILOT_POLICY_ENFORCE=1
