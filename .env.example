# ForgePilot — Connector Configuration
# Copy to .env.local for local dev, or set on the NAS host before deploying.
# All keys can also be set via the Settings UI at /settings.

# Anthropic (required for Research Run + AI Requirements generation)
ANTHROPIC_API_KEY=sk-ant-...

# Linear Connector
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=your-team-id

# GitHub Connector
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=Jokerbitt
GITHUB_REPOSITORIES=forgepilot
