# ════════════════════════════════════════════════════════════════
# ForgePilot — Environment Variables
# Copy to .env.local and fill in your values.
# Most variables are optional. Auth is enabled by default; change the admin password.
# ════════════════════════════════════════════════════════════════

# ── System paths ────────────────────────────────────────────────
# Where config/state JSON files are stored (default: ./config)
# Can point to any drive: /mnt/data, D:\ForgePilot\config, etc.
# FORGEPILOT_DATA_DIR=/path/to/config

# Where your documentation/knowledge base lives (optional)
# Set this to enable the Knowledge Indexer
# FORGEPILOT_DOCS_DIR=/Volumes/MyDrive/docs

# ── AI Providers ─────────────────────────────────────────────────
# Add the key for whichever provider(s) you want to use.
# You only need ONE — ForgePilot works with any.

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI GPT (https://platform.openai.com)
# OPENAI_API_KEY=sk-proj-...

# Groq — ultra-fast, free tier (https://console.groq.com)
# GROQ_API_KEY=gsk_...

# ─── Sentry (optional) ──────────────────────────────────────────────────────
# Error monitoring + performance tracing (M97)
# Get DSN at https://sentry.io → Project → Settings → Client Keys
# NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=forgepilot

# ─── OpenTelemetry (optional) ────────────────────────────────────────────────
# Distributed tracing (M98) — export to Jaeger (local) or Honeycomb (prod)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY
# LOG_LEVEL=info                   # Pino log level: trace | debug | info | warn | error | fatal

# ─── Vercel Cron (optional) ─────────────────────────────────────────────────
# VERCEL_URL=https://forgepilot-pr-123.vercel.app
# SECURITY: Generate with: openssl rand -base64 32
# CRON_SECRET=your-long-random-secret-here

# ─── API Key Authentication (optional — set to protect all /api/ routes) ────
# If set, all /api/ routes require: Authorization: Bearer <key>
# Excluded from check: /api/intake, /api/cron/*, /api/health, /api/ready, /api/webhooks/*
# Generate with: openssl rand -hex 32
# FORGEPILOT_API_KEY=

# ─── Webhook Security (optional — HMAC validation for /api/intake) ──────────
# Generate with: openssl rand -hex 32
# INTAKE_WEBHOOK_SECRET=

# Mistral AI — EU-based, DSGVO-friendly (https://console.mistral.ai)
# MISTRAL_API_KEY=...

# Google Gemini (https://aistudio.google.com)
# GOOGLE_API_KEY=AIza...

# Together AI — open models (https://api.together.xyz)
# TOGETHER_API_KEY=...

# Ollama — local, no API key needed
# OLLAMA_BASE_URL=http://localhost:11434

# LM Studio — local OpenAI-compatible server
# LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ── Supabase (optional — enhances ForgePilot with realtime + vector search)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# ── Connectors ───────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_...
# LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM_ID=team-...

# ── Deployment ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Supabase (extended) ──────────────────────────────────────────
# SUPABASE_SERVICE_KEY=eyJ...

# ── Linear Integration (extended) ───────────────────────────────
# LINEAR_WEBHOOK_SECRET=...

# ── Telegram Bot (M151) ─────────────────────────────────────────
# Optional: configure in /settings → Telegram section instead of env vars
# TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFfGgHhIiJjKkLlMm...
# TELEGRAM_CHAT_ID=123456789          # numeric chat ID or @channelname
# TELEGRAM_WEBHOOK_SECRET=your-long-random-secret-for-webhook-verification

# ── Next.js ──────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Auth (mandatory) ──────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Admin password for the ForgePilot login page
FORGEPILOT_ADMIN_EMAIL=admin@forgepilot.local
# SECURITY: Minimum 12 characters, use a password manager
FORGEPILOT_ADMIN_PASSWORD=your-password-here
# FORGEPILOT_ADMIN_NAME=Admin
# FORGEPILOT_TENANT_ID=default

# Set to "false" only for local development without auth
# FORGEPILOT_AUTH_ENABLED=false
# FORGEPILOT_AUTH_DISABLED=true  # Unsafe: disables login/session protection

# ─── Grok / xAI Critic (M165) ─────────────────────────────────────────────────
# Get $25 free credits at https://console.x.ai
# XAI_API_KEY=xai-...

# ─── PostgreSQL (optional — app works without it using JSON files) ─────────────
# DATABASE_URL=postgresql://forgepilot:forgepilot@localhost:5432/forgepilot
# Storage modes:
# - unset/json: JSON files only unless DATABASE_URL is set
# - postgres: read/write delegations from Postgres
# - dual: read from JSON and mirror writes to Postgres during migration
# FORGEPILOT_DELEGATION_STORAGE=dual
# Setup: docker-compose up -d postgres && npm run db:push
# Backfill existing JSON data: npm run db:backfill
# POSTGRES_USER=forgepilot
# POSTGRES_PASSWORD=forgepilot
# POSTGRES_DB=forgepilot
