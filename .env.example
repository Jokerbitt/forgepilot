# ForgePilot — Environment Configuration
# Copy to .env.local for local dev, or set as environment variables before Docker deploy.
# All keys can also be set via the Settings UI at /settings → stored in config/api-keys.json.
# Keys set here as env vars take precedence over UI-stored keys.

# ─── AI Provider ────────────────────────────────────────────────────────────
# Anthropic — required for AI execution plans, research runs, AI requirements generation
ANTHROPIC_API_KEY=sk-ant-...

# Ollama — optional local AI (http://localhost:11434 by default)
# Start Ollama: ollama serve && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ─── Connectors ─────────────────────────────────────────────────────────────
# Linear — required for Linear work items
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=your-team-id

# GitHub — required for GitHub issues/PRs as work items
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=YourOrg
GITHUB_REPOSITORIES=repo1,repo2

# ─── NAS (optional) ─────────────────────────────────────────────────────────
# Path to the NAS knowledge base (for NAS indexer)
# Default: /Volumes/Sven/NAS/Codex/KI Betriebssystem
# NAS_KNOWLEDGE_PATH=/Volumes/Sven/NAS/Codex/KI Betriebssystem

# ─── Sentry (optional) ──────────────────────────────────────────────────────
# Error monitoring + performance tracing (M97)
# Get DSN at https://sentry.io → Project → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# Used by Sentry webpack plugin to upload source maps (CI only)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=forgepilot

# ─── OpenTelemetry (optional) ────────────────────────────────────────────────
# Distributed tracing for AI call timing (M98)
# Dev: export to Jaeger (docker run -p 4318:4318 jaegertracing/all-in-one)
# Prod: export to Honeycomb or Vercel Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY
LOG_LEVEL=info

# ─── Vercel (optional) ──────────────────────────────────────────────────────
# Injected automatically by Vercel — only needed for local preview simulation
# VERCEL_URL=https://forgepilot-pr-123.vercel.app
# CRON_SECRET=your-long-random-secret-here

# ─── App (optional) ─────────────────────────────────────────────────────────
# Port for the Next.js server (default: 3000)
# PORT=3000

# Node environment
NODE_ENV=production
